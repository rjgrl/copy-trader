# Telegram MT5 Copier — example environment file
# Copy to .env and fill in values. Never commit .env.
#
# Development: place .env in the project root (next to run.py)
# Packaged EXE: place .env in %LOCALAPPDATA%\TelegramMT5Copier\.env
# Secrets are NEVER bundled into the executable.

# Telegram API credentials (from https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional path overrides (absolute paths recommended)
# DATA_DIR=data
# LOG_DIR=logs
# DRY_RUN=true
# COPY_TRADING_ENABLED=false
